# One Network module and install name, with explicit non-overlapping source providers.
# TARGET_ARM64 is the existing Android/iOS build profile in this tree.
if(TARGET_ARM64)
    set(network_default socket)
else()
    set(network_default canonical)
endif()
set(DARLING_SWIFT_NETWORK_PROVIDER "${network_default}" CACHE STRING "Network source provider: canonical or socket")
set_property(CACHE DARLING_SWIFT_NETWORK_PROVIDER PROPERTY STRINGS canonical socket)
set(NETWORK_PROVIDER_FLAGS)
if(DARLING_SWIFT_NETWORK_PROVIDER STREQUAL "socket")
    set(NETWORK_SOURCES)
    foreach(file IN ITEMS Connection Endpoint Listener Network Protocols Socket)
        list(APPEND NETWORK_SOURCES "${OVERLAYS}/Network/${file}.swift")
    endforeach()
    list(APPEND NETWORK_PROVIDER_FLAGS -Xcc "-fmodule-map-file=${OVERLAYS}/Network/shims/module.modulemap")
elseif(DARLING_SWIFT_NETWORK_PROVIDER STREQUAL "canonical")
    set(NETWORK_SOURCES "${OVERLAYS}/Network/CanonicalNetwork.swift")
    foreach(file IN ITEMS NWConnection NWEndpoint NWError NWListener NWParameters NWPath NWProtocol NWProtocolIP NWProtocolTCP NWProtocolTLS NWProtocolUDP)
        list(APPEND NETWORK_SOURCES "${OVERLAYS}/Network/${file}.swift")
    endforeach()
else()
    message(FATAL_ERROR "DARLING_SWIFT_NETWORK_PROVIDER must be canonical or socket")
endif()
