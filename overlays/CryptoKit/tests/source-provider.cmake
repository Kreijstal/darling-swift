# Configure-only source ownership/selection guard; no Swift or crypto execution.
set(provider "${CMAKE_CURRENT_LIST_DIR}/../source-provider.cmake")
if(NOT DEFINED OVERLAYS)
    set(OVERLAYS "${CMAKE_CURRENT_LIST_DIR}/../..")
endif()
set(target_count 0)
set(removed_count 0)
function(remove_sdk_framework name)
    if(NOT name STREQUAL "CryptoKit")
        message(FATAL_ERROR "Wrong framework removal")
    endif()
    set(removed_count 1 PARENT_SCOPE)
endfunction()
function(add_darling_swift_library name)
    cmake_parse_arguments(P "FRAMEWORK" "" "SOURCES;NATIVE_SOURCES;MODULES;FLAGS;NATIVE_FLAGS;LIBRARIES" ${ARGN})
    list(LENGTH P_SOURCES swift_count)
    list(LENGTH P_NATIVE_SOURCES native_count)
    if(NOT name STREQUAL "CryptoKit" OR NOT P_FRAMEWORK OR
            NOT swift_count EQUAL 30 OR NOT native_count EQUAL 3)
        message(FATAL_ERROR "CryptoKit target/source ownership mismatch")
    endif()
    set(target_count 1 PARENT_SCOPE)
endfunction()
function(install)
endfunction()
include("${provider}")
if(DARLING_CRYPTOKIT_BASE_SOURCE AND DARLING_CRYPTOKIT_AEAD_SOURCE)
    if(NOT target_count EQUAL 1 OR NOT removed_count EQUAL 1)
        message(FATAL_ERROR "Enabled source target is absent")
    endif()
elseif(NOT target_count EQUAL 0 OR NOT removed_count EQUAL 0)
    message(FATAL_ERROR "Disabled source target changed provider ownership")
endif()
